import { defineConfig } from 'vite';

export default defineConfig({
  // Use relative paths so the build works at any URL depth (incl. GitHub Pages subpaths)
  base: './',

  server: {
    headers: {
      // Required for SharedArrayBuffer-using WASM (the bg removal model)
      'Cross-Origin-Opener-Policy': 'same-origin',
      'Cross-Origin-Embedder-Policy': 'require-corp',
    },
  },

  preview: {
    headers: {
      'Cross-Origin-Opener-Policy': 'same-origin',
      'Cross-Origin-Embedder-Policy': 'require-corp',
    },
  },

  optimizeDeps: {
    exclude: ['@imgly/background-removal'],
  },

  build: {
    target: 'es2022',
    sourcemap: false,
    chunkSizeWarningLimit: 5000,
  },
});